# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# Supabase Frontend Browser Client Configuration (Phase 1)
# Use the project URL and Anon / Publishable key. Never use service-role keys in browser code.
VITE_SUPABASE_URL="https://your-project.supabase.co"
VITE_SUPABASE_PUBLISHABLE_KEY="your-anon-publishable-key"

# Supabase Testing Configuration (BookSuite-Dev)
SUPABASE_URL="https://your-project.supabase.co"
SUPABASE_ANON_KEY="your-anon-publishable-key"

# Automated Test Accounts (Fictional Demo Centers)
TEST_USER_A_EMAIL="user_a_pickleball@booksuite.demo"
TEST_USER_A_PASSWORD="UserAPassword123!"
TEST_USER_B_EMAIL="user_b_badminton@booksuite.demo"
TEST_USER_B_PASSWORD="UserBPassword123!"

# Optional: Set to true in .env.test to permit safe state changes on disposable test fixtures
CONFIRM_TEST_ENV="false"

# Cloudflare Turnstile is optional during development. Configure
# VITE_TURNSTILE_SITE_KEY in AI Studio Secrets only when enabling live public bookings.

# LockaCourt Payment Gateway Configuration (Stage 2: HitPay Sandbox Optional During Dev)
# Configure actual secrets ONLY in Supabase Edge Function secrets, never in Vite client vars.
# Keep ACTIVE_PAYMENT_PROVIDER="paymongo" until HitPay sandbox credentials are configured.
APP_BASE_URL="https://lockacourt.com"
ACTIVE_PAYMENT_PROVIDER="paymongo"
ALLOWED_PAYMENT_PROVIDERS="paymongo"
HITPAY_ENV="sandbox"
HITPAY_SANDBOX_API_URL="https://api.sandbox.hit-pay.com"
# Optional during development & offline testing. Real HitPay checkout stays disabled
# (returning `provider_not_configured`) until both values are configured from HitPay Sandbox.
HITPAY_SANDBOX_API_KEY=""
HITPAY_SANDBOX_WEBHOOK_SALT=""
